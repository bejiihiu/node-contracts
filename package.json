{
    "name": "@bejiihiu/design-contracts",
    "version": "1.0.2",
    "description": "Design by Contract for JavaScript, TypeScript, Node.js and Bun",
    "license": "MIT",
    "author": "design-contracts contributors",
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bejiihiu/node-contracts.git"
    },
    "bugs": {
        "url": "https://github.com/bejiihiu/node-contracts/issues"
    },
    "homepage": "https://github.com/bejiihiu/node-contracts#readme",
    "keywords": [
        "contracts",
        "design-by-contract",
        "preconditions",
        "postconditions",
        "invariants",
        "typescript",
        "assertions",
        "dbc"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./adapters": {
            "import": {
                "types": "./dist/adapters/index.d.ts",
                "default": "./dist/adapters/index.js"
            },
            "require": {
                "types": "./dist/adapters/index.d.cts",
                "default": "./dist/adapters/index.cjs"
            }
        },
        "./decorators": {
            "import": {
                "types": "./dist/decorators/index.d.ts",
                "default": "./dist/decorators/index.js"
            },
            "require": {
                "types": "./dist/decorators/index.d.cts",
                "default": "./dist/decorators/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "docs",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=18"
    },
    "packageManager": "bun@1.4.2",
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "bench": "vitest bench --reporter=verbose",
        "lint": "biome check .",
        "format": "biome format --write .",
        "typecheck": "tsc --noEmit",
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "publint": "publint",
        "attw": "attw --pack . --profile node16",
        "prepublishOnly": "npm run clean && npm run build && npm run publint && npm run attw"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@biomejs/biome": "^2.6.7",
        "@vitest/coverage-v8": "^5.1.0",
        "publint": "^0.3.25",
        "tsup": "^9.0.0",
        "typescript": "~5.9.3",
        "vitest": "^5.1.0"
    }
}
